// Landing page: a static-assets-only Worker serving site/ on kitedb.dotly.mn.
{
  "name": "kitedb",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "kitedb.dotly.mn", "custom_domain": true }
  ]
}
